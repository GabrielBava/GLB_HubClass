# LIFE CLASS — exemplo de configuração. Copie para .env e ajuste. Nunca versione o .env.
# Variáveis definidas no ambiente (ex.: no orquestrador) têm prioridade sobre este arquivo.

# Ambiente: development | production
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
# Endereço público da aplicação (usado em convites, links de redefinição e na checagem de origem).
APP_ORIGIN=https://lifeclass.exemplo.com.br
# Outras origens aceitas, separadas por vírgula (opcional).
EXTRA_ORIGINS=

# Segredo da aplicação: obrigatório em produção, mínimo de 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Protege a criptografia das chaves de MFA e o HMAC do IP no aceite dos termos.
# Trocar este valor invalida as chaves de MFA já cadastradas.
APP_SECRET=

# PostgreSQL (obrigatório em produção). Sem ele, em desenvolvimento usa-se o banco embutido em DATA_DIR.
DATABASE_URL=postgres://lifeclass:senha@localhost:5432/lifeclass
DATA_DIR=./data

# Armazenamento privado dos arquivos: local | s3
STORAGE_DRIVER=s3
S3_BUCKET=lifeclass-conteudos
S3_REGION=sa-east-1
# Para MinIO ou outro serviço compatível:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Prefira credenciais do papel da máquina (IAM). Use as chaves só se necessário.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mail (convites, redefinição de senha e avisos). Sem SMTP, o administrador recebe os links na tela.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=LIFE CLASS <nao-responda@exemplo.com.br>

# Antivírus ClamAV (clamd) para os arquivos enviados. Opcional, recomendado em produção.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Conversão de DOCX em PDF com LibreOffice (soffice instalado no servidor).
DOCX_CONVERSION=true
SOFFICE_PATH=soffice

# Atrás de proxy reverso/balanceador com HTTPS: true para usar o IP real do cliente.
TRUST_PROXY=true
# Cookies Secure: padrão true em produção. Só desative em desenvolvimento local sem HTTPS.
# COOKIE_SECURE=true
LOG_LEVEL=info

# Apenas para demonstração: permite o banco embutido com NODE_ENV=production.
# ALLOW_EMBEDDED_DB_IN_PRODUCTION=false
