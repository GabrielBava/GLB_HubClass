{
  "name": "life-class",
  "private": true,
  "version": "0.1.0",
  "description": "LIFE CLASS — plataforma corporativa de educação do Grupo Life Brasil",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "vercel-build": "npm run build && node dist/server/server/scripts/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "seed": "tsx server/scripts/seed.ts",
    "admin:create": "tsx server/scripts/create-admin.ts",
    "audit:purge": "tsx server/scripts/purge.ts",
    "demo:record": "node tools/demo/record.cjs",
    "demo:build": "vite build --mode demo && node tools/demo/build-html.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@electric-sql/pglite": "0.5.11",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@napi-rs/canvas": "1.0.13",
    "@node-rs/argon2": "2.2.2",
    "@tanstack/react-query": "5.90.2",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.10.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "lucide-react": "0.462.0",
    "nodemailer": "10.2.1",
    "otplib": "12.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4",
    "recharts": "2.15.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
